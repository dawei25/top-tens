{
  "name": "top-tens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:css": "node e2e/css-states.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "verify": "npm test && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.api.json --noEmit && npm run lint && npm run lint:css && npm run e2e",
    "verify:deploy": "vitest run src && tsc -p tsconfig.app.json --noEmit && npm run lint:css && vite build",
    "inspect": "NODE_NO_WARNINGS=1 NODE_USE_ENV_PROXY=1 tsx scripts/inspect.ts",
    "build:puzzles": "NODE_NO_WARNINGS=1 NODE_USE_ENV_PROXY=1 tsx scripts/build.ts",
    "build:test": "NODE_NO_WARNINGS=1 NODE_USE_ENV_PROXY=1 tsx scripts/build.ts --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "an-array-of-english-words": "^2.0.0",
    "cheerio": "^1.2.0",
    "countries-list": "^3.4.1",
    "oxlint": "^1.89.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
