# TENtacle backend settings. Copy to .env.local for local development (it's gitignored), or set them in Vercel
# (Project > Settings > Environment Variables). See docs/BACKEND.md.
#
# Leave the first two empty and the game runs with no server at all, exactly as before: nothing is sent, and the
# backend code is never downloaded.

# Public (they end up in the browser bundle; that's what they're for).
# Supabase > Project Settings > API Keys: the project URL and the publishable key (sb_publishable_...). A legacy anon
# key works too until Supabase retires it. VITE_SUPABASE_PUBLISHABLE_KEY is accepted as another name for the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Sign-in methods, comma separated: "google", "password" (email and password, nothing emailed), "email" (a
# link by email). Default "google,email"; "none" for anonymous score stats without accounts. Unknown names are ignored.
VITE_SIGN_IN=

# Optional, with "google" in VITE_SIGN_IN. The OAuth web client ID (1234-abc.apps.googleusercontent.com), from
# Google Cloud > Google Auth Platform > Clients: the same client Supabase's Google provider uses. With it, Google
# sign-in goes from this site to Google and back to this site's auth/google.html (add that exact address to the
# client's Authorized redirect URIs), so Google's account chooser names this site instead of <ref>.supabase.co.
# Without it, Google sign-in goes through Supabase's redirect.
VITE_GOOGLE_CLIENT_ID=

# Optional. An address for privacy questions, shown on the privacy page and as "forgot your password? ask us at ...".
VITE_PRIVACY_CONTACT=

# SECRET. Server only: the Vercel function api/delete-account.ts needs it to delete a sign-in. Never prefix it with
# VITE_ (that would put it in the browser bundle) and never commit it.
# Supabase > Project Settings > API Keys: a secret key (sb_secret_...), or the legacy service_role key.
# SUPABASE_SECRET_KEY is accepted as another name for it.
SUPABASE_SERVICE_ROLE_KEY=
