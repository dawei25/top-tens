# TENtacle backend settings. Copy to .env.local for local development (it's gitignored), or set them in Vercel
# (Project > Settings > Environment Variables). See docs/BACKEND.md.
#
# Leave the first two empty and the game runs with no server at all, exactly as before: nothing is sent, and the
# backend code is never downloaded.

# Public (they end up in the browser bundle; that's what they're for).
# Supabase > Project Settings > API: the project URL and the anon (public) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Sign-in methods to offer: "google,email" (the default), "email", "google", or "none" for anonymous score
# stats without accounts.
VITE_SIGN_IN=

# Optional. An address for privacy questions, shown on the privacy page.
VITE_PRIVACY_CONTACT=

# SECRET. Server only: the Vercel function api/delete-account.ts needs it to delete a sign-in. Never prefix it with
# VITE_ (that would put it in the browser bundle) and never commit it.
# Supabase > Project Settings > API: the service_role key.
SUPABASE_SERVICE_ROLE_KEY=
